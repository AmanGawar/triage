# Copy this file to .env and fill in your real key. Never commit the real .env file.

# Required for real LLM output. If unset, the system runs in a deterministic
# offline mock mode (see common/llm_client.py) so the code is still fully runnable
# without credentials.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-4-5 if unset.
LLM_MODEL=claude-sonnet-4-5
